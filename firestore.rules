rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin-only Library Seat Management System
    match /seats/{seatId} {
      allow read, write: if true;
    }
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
    match /layouts/{layoutId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
